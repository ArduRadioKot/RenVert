{
  "sourceLanguage": "en",
  "strings": {
    "A native macOS rename-to-convert utility. Files never leave this Mac.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативная утилита для macOS: переименуйте файл — и он сконвертируется. Файлы не покидают этот Mac."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "Add Folder…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить папку…"
          }
        }
      }
    },
    "Allow Renvert in Privacy & Security → Files and Folders, then relaunch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Renvert в «Конфиденциальность и безопасность → Файлы и папки» и перезапустите."
          }
        }
      }
    },
    "An interrupted operation could not be recovered cleanly.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось аккуратно восстановить прерванную операцию."
          }
        }
      }
    },
    "Archive entry points outside the destination.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент архива указывает за пределы папки назначения."
          }
        }
      }
    },
    "Ask first": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросить сначала"
          }
        }
      }
    },
    "Authors: FrogeeSoft": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторы: FrogeeSoft"
          }
        }
      }
    },
    "AVFoundation cannot export this asset.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AVFoundation не может экспортировать этот файл."
          }
        }
      }
    },
    "Background removal needs a raster image.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для удаления фона нужно растровое изображение."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Cancel All": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить все"
          }
        }
      }
    },
    "Change a file’s extension in Finder. Renvert converts the actual contents, keeps a backup, and stays in the menu bar.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените расширение файла в Finder. Renvert конвертирует содержимое, сохранит копию и останется в строке меню."
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить снова"
          }
        }
      }
    },
    "Clear History": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить историю"
          }
        }
      }
    },
    "Conversion failed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось конвертировать"
          }
        }
      }
    },
    "Conversion from %@ to %@ is not supported.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертация из %1$@ в %2$@ не поддерживается."
